ENVIRONMENT=development
NODE_ENV=development
APP_NAME=ClickUp Automation API
APP_PREFIX=api
APP_URL=http://localhost:4000
PORT=4000
DOCS_PREFIX=docs
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=clickup_automation

REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=true

CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
CLICKUP_REDIRECT_URI=http://localhost:4000/api/clickup/oauth/callback
CLICKUP_API_BASE_URL=https://api.clickup.com/api/v2

ENCRYPTION_KEY=
JWT_ACCESS_SECRET=
JWT_ISSUER=clickup-automation-api
JWT_AUDIENCE=clickup-automation-web
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_DAYS=30
REFRESH_COOKIE_NAME=clickup_refresh
INTERNAL_API_KEY=
CRON_JOBS_DISABLED=false
CRON_JOBS_TIMEZONE=Asia/Karachi
TIME_ENTRY_SYNC_CRON=0 */5 * * * *
